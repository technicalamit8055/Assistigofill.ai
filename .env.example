# ---------------------------------------------------------------------------
# Assistigo.ai environment template
# Copy to .env.local (web app) and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Local dev (supabase start) prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Bypasses RLS. Never expose to the browser or the extension.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Direct Postgres connection, used only by RLS / integration tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Comma separated extension IDs allowed to call the extension API surface and to be handed a
# pairing code by /extension/connect. Leave empty in local dev to allow any well-formed id.
# Outside local this FAILS CLOSED: an empty allowlist means no extension can pair at all.
# Find the id at chrome://extensions with developer mode on.
EXTENSION_ALLOWED_IDS=

# Baked into the extension at build time; must match an origin in the manifest's
# externally_connectable list. Defaults to http://localhost:3000 when unset.
VITE_DASHBOARD_URL=

# --- Encryption -----------------------------------------------------------
# 32-byte key, base64 encoded. Used for AES-256-GCM field encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# --- OCR / AI providers ---------------------------------------------------
# mock | tesseract | anthropic
OCR_PROVIDER=mock
# Only required when OCR_PROVIDER=anthropic. See docs/AI_PIPELINE.md before enabling:
# sending customer documents to a third party requires org-level opt-in.
ANTHROPIC_API_KEY=

# --- Background jobs ------------------------------------------------------
# Shared secret for POST /api/jobs/run, which drains the job queue (OCR extraction and friends).
# That route runs with the service-role key, so it FAILS CLOSED: leave this unset and the
# endpoint refuses every request. Set it wherever a scheduler will call the route.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
JOB_RUNNER_SECRET=

# --- Billing --------------------------------------------------------------
# mock | razorpay | stripe
BILLING_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Observability --------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
